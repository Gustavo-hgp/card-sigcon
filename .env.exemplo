# Copie este arquivo para .env (na mesma pasta) e preencha.
# O .env esta no .gitignore e o agente do Kiro nao tem permissao de le-lo.

# Token pessoal do GitLab: read_api para testar (coletar/simular/retro), api para publicar.
GITLAB_TOKEN=

# Opcional: repositorio do SIGCON. Sem esta linha, a ferramenta usa a pasta "gggt" ao lado
# desta (ex.: C:/prodemge/sigcon/gggt para C:/prodemge/sigcon/card-sigcon). Use barras
# normais e um caminho sem espacos. Depois de mudar, feche e abra o card-ui.cmd.
# CARD_SIGCON_REPO=C:/caminho/do/gggt
